{
  "version": "2.2",
  "metadata": { "rules_version": "1.0" },
  "rules": [
    {
      "id": "fiber-block-error-response",
      "name": "Block a rendered not-found response",
      "tags": { "type": "security_scanner", "category": "attack_attempt" },
      "conditions": [
        {
          "operator": "match_regex",
          "parameters": {
            "inputs": [{ "address": "server.response.status" }],
            "regex": "^404$"
          }
        }
      ],
      "transformers": [],
      "on_match": ["block"]
    }
  ]
}
